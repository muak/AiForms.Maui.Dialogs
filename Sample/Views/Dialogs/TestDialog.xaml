<?xml version="1.0" encoding="UTF-8"?>
<extra:DialogView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extra="clr-namespace:AiForms.Dialogs;assembly=AiForms.Maui.Dialogs"
    x:Class="Sample.Views.TestDialog"
    HorizontalLayoutAlignment="Center" VerticalLayoutAlignment="Center"
    WidthRequest="250"
    HeightRequest="400"
    CornerRadius="10" 
    OverlayColor="#80000000"
    IsCanceledOnTouchOutside="True"
    >
    
    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="White">
        <Label Grid.Row="0" Text="Test Dialog" FontSize="24" HorizontalOptions="Center" Margin="0,16,0,16"/>
        <Label Grid.Row="1" Text="This is a test dialog." FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
        <Button Grid.Row="2" Text="Tap" Clicked="Button_Clicked" />
    </Grid>
</extra:DialogView>
